# SQLite database (local development — no Docker required)
DATABASE_URL="file:./prisma/dev.db"

# Optional: cap commits per analysis (default 80)
# MAX_COMMITS_PER_ANALYSIS=80

# Vercel production: use Vercel Postgres and set DATABASE_URL to the Postgres connection string.
# Then change prisma/schema.prisma provider from "sqlite" to "postgresql" and run: npx prisma db push
